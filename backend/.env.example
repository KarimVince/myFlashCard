# Copy to .env and fill in values — .env is git-ignored

DATABASE_URL=postgresql://user:password@host:5432/myflashcard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
ADMIN_PASSWORD_HASH=your-bcrypt-hash     # generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
CORS_ORIGINS=http://localhost:3000,https://myflashcard.app
