<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. The login token (session.xml) is never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
